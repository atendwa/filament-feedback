{
    "name": "atendwa/filament-feedback",
    "description": "Feedback for Filament apps: a public form with anonymous or named submissions, a staff inbox with replies, internal notes and resolution, and \"My feedback\" for signed-in users.",
    "keywords": ["laravel", "filament", "filament-plugin", "feedback", "helpdesk"],
    "homepage": "https://github.com/atendwa/filament-feedback",
    "license": "MIT",
    "authors": [
        {
            "name": "Anthony Tendwa",
            "homepage": "https://github.com/atendwa"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "nunomaduro/phpinsights": "^2.15",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-permission": "^6.0"
    },
    "suggest": {
        "spatie/laravel-permission": "Lets the package alert everyone holding the Respond:Feedback permission about new feedback and replies."
    },
    "autoload": {
        "psr-4": {
            "Atendwa\\Feedback\\": "src/",
            "Atendwa\\Feedback\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atendwa\\Feedback\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atendwa\\Feedback\\FeedbackServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint --parallel",
        "quality": [
            "pint --parallel --test",
            "rector --dry-run --no-diffs",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
